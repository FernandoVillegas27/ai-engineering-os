{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-engineering-os.local/schemas/skill.schema.json",
  "title": "Skill",
  "description": "Defines reusable technology or domain knowledge that can be attached to agents at runtime.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id","description","source","trust","capabilities","domains","compatible_agents","status"],
  "properties": {
    "id": {"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "description": {"type":"string","minLength":20},
    "source": {
      "type":"object",
      "additionalProperties":false,
      "required":["type","provider","path"],
      "properties":{
        "type":{"type":"string","enum":["company","external","generated"]},
        "provider":{"type":"string","minLength":1},
        "repository":{"type":["string","null"]},
        "path":{"type":"string","minLength":1},
        "version":{"type":["string","null"]}
      }
    },
    "trust": {
      "type":"object",
      "additionalProperties":false,
      "required":["level","reviewed"],
      "properties":{
        "level":{"type":"string","enum":["company","curated","community","generated"]},
        "reviewed":{"type":"boolean"}
      }
    },
    "capabilities": {
      "type":"array","minItems":1,"uniqueItems":true,
      "items":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"}
    },
    "domains": {
      "type":"array","minItems":1,"uniqueItems":true,
      "items":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"}
    },
    "technologies": {
      "type":"array",
      "items":{
        "type":"object","additionalProperties":false,"required":["name"],
        "properties":{
          "name":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "versions":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}}
        }
      },
      "default":[]
    },
    "compatible_agents": {
      "type":"array","minItems":1,"uniqueItems":true,
      "items":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"}
    },
    "tools": {
      "type":"object","additionalProperties":false,
      "properties":{
        "required":{"type":"array","uniqueItems":true,"items":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"}},
        "recommended":{"type":"array","uniqueItems":true,"items":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"}}
      }
    },
    "activation": {
      "type":"object","additionalProperties":false,
      "properties":{
        "triggers":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
        "project_signals":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}}
      }
    },
    "status":{"type":"string","enum":["candidate","enabled","disabled","deprecated"]}
  }
}
